.ipynb_checkpoints/
.idea/
.vscode/
*.swp
*.swo
*~

# Local datasets; keep documentation and dataset configuration
/data/*
!/data/README*
!/data/.gitkeep
!/data/*.yaml
!/data/*.yml
/datasets/
*.cache

